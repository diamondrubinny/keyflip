{
  "name": "keyflip-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fixes text typed in the wrong keyboard layout (Hebrew/English).",
  "scripts": {
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "e2e": "node tests/e2e.cjs",
    "a11y": "node tests/a11y.cjs",
    "eval": "node --experimental-strip-types scripts/eval.ts",
    "check-version": "node scripts/check-version.mjs",
    "audit": "npm audit --audit-level=moderate"
  },
  "devDependencies": {
    "@types/chrome": "0.3.6",
    "@types/node": "^22.20.5",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "playwright": "1.64.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.6"
  }
}
