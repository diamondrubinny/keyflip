{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "KeyFlip",
  "version": "0.1.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/diamondrubinny/keyflip",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_title": "__MSG_extShortName__",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "convert-selection": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "__MSG_commandConvert__"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
