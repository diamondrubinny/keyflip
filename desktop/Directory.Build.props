<Project>

  <!-- Shared by every desktop project. The version must match extension/package.json and
       extension/static/manifest.json (enforced in CI by extension/scripts/check-version.mjs). -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Product>KeyFlip</Product>
    <Company>KeyFlip</Company>
    <Copyright>Copyright 2026 Diamond Rubinny. Licensed under Apache-2.0.</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
