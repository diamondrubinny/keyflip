<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Only for System.Windows.Automation (UI Automation IsPassword checks in Electron/WPF/UWP apps). No WPF UI is used. -->
    <UseWPF>true</UseWPF>
    <AssemblyName>KeyFlip</AssemblyName>
    <RootNamespace>KeyFlip.App</RootNamespace>
    <ApplicationIcon>Assets\keyflip.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- MSIX (Microsoft Store) build: dotnet publish -p:KeyFlipPackaged=true.
       Adds the Windows SDK projection so the packaged app can use Windows.ApplicationModel.StartupTask
       (HKCU\...\Run writes are redirected inside MSIX packages and would not take effect). -->
  <PropertyGroup Condition="'$(KeyFlipPackaged)' == 'true'">
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <DefineConstants>$(DefineConstants);PACKAGED</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KeyFlip.Core\KeyFlip.Core.csproj" />
    <EmbeddedResource Include="Assets\keyflip.ico" LogicalName="keyflip.ico" />
    <!-- UseWPF removes System.IO from the implicit usings; the app relies on it. -->
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
