<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>KeyFlip.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Single sources of truth shared with the Chrome extension. -->
    <EmbeddedResource Include="..\..\shared\layouts\*.json" LogicalName="layouts.%(Filename).json" />
    <EmbeddedResource Include="..\..\extension\src\data\en.txt" LogicalName="en.txt" />
    <EmbeddedResource Include="..\..\extension\src\data\he.txt" LogicalName="he.txt" />
    <EmbeddedResource Include="..\..\extension\src\data\ru.txt" LogicalName="ru.txt" />
  </ItemGroup>

</Project>
